# server/.env
PORT=4000
MONGO_URI=mongodb://localhost:27017/tracenest
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
CLIENT_ORIGIN=http://localhost:5173
ALLOW_PRIVATE_TARGETS=false
NODE_ENV=development
# Proxy hops to trust for the client IP (rate limits). Default: 1 in production, none otherwise.
# Behind Vercel rewrite + Render this is likely 2; check req.ips / x-forwarded-for on the deployed stack.
TRUST_PROXY=
# Optional: enables the AI debugging assistant
ANTHROPIC_API_KEY=
